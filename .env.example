# Configure these in the Netlify environment variable settings; DO NOT commit actual secrets.
# Must be a strong unique password with at least 14 characters.
ADMIN_PASSWORD=
# Must be at least 32 characters and unrelated to the admin password.
ADMIN_SESSION_SECRET=
# E-mail notifications; sender must be verified in Resend.
RESEND_API_KEY=
QUOTE_FROM_EMAIL=
QUOTE_TO_EMAIL=
# European region (don't change region after accepting submissions).
BLOBS_REGION=eu-central-1
